{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://127.0.0.1:8080" }
    }
  },
  "Ldb": {
    "Database": {
      "Provider": "postgres",
      "DmlConnectionString": "",
      "DdlConnectionString": "",
      "MongoDatabase": "ldb",
      "CommandTimeoutSeconds": 15
    },
    "Security": {
      "AllowInsecureHttp": false,
      "TimestampToleranceSeconds": 30,
      "MaxBodyBytes": 1048576,
      "FailedAuthPerMinute": 10,
      "TrustedProxies": [],
      "Keys": []
    },
    "Schema": {
      "DestructiveMode": "Apply",
      "MaxTables": 64
    },
    "Limits": {
      "MaxRows": 1000,
      "MaxInsertRows": 1000
    },
    "WriteBehind": {
      "Enabled": false,
      "Namespaces": [],
      "FlushIntervalSeconds": 30,
      "FlushAt": [],
      "TimeZone": "UTC",
      "FlushThreshold": 1000,
      "JournalPath": ""
    }
  }
}
