{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:8443",
        "Certificate": { "Path": "/etc/ldb/cert.pfx", "Password": "set-me" }
      }
    }
  },
  "Ldb": {
    "Database": {
      "Provider": "postgres",
      "DmlConnectionString": "Host=db.internal;Port=5432;Database=ldb;Username=ldb_data;Password=change-me;SSL Mode=Require",
      "DdlConnectionString": "Host=db.internal;Port=5432;Database=ldb;Username=ldb_schema;Password=change-me;SSL Mode=Require"
    },
    "Security": {
      "TrustedProxies": [],
      "Keys": [
        {
          "KeyId": "gameserver",
          "Current": "file:/etc/ldb/gameserver.secret",
          "Next": null,
          "AllowedNamespaces": [ "mygame", "otherbundle" ],
          "AllowedOperations": [],
          "AllowedCidrs": [ "203.0.113.10/32" ],
          "RequestsPerMinute": 600,
          "AllowUnfilteredWrites": false
        }
      ]
    },
    "Schema": { "DestructiveMode": "Apply" }
  }
}
